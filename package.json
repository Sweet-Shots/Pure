{
  "name": "pure-browser",
  "version": "2.3.0",
  "description": "A minimal Chromium browser — no bloat, just browsing.",
  "license": "MIT",
  "author": "Pure Browser",
  "main": "main/index.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "lucide-static": "^1.54.0"
  },
  "build": {
    "appId": "com.pure-browser.app",
    "productName": "Pure Browser",
    "artifactName": "Pure-Browser-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Sweet-Shots",
      "repo": "Pure",
      "releaseType": "release"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": "html",
        "name": "HTML Document",
        "role": "Viewer"
      },
      {
        "ext": "htm",
        "name": "HTML Document",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Viewer"
      },
      {
        "ext": "svg",
        "name": "SVG Image",
        "role": "Viewer"
      },
      {
        "ext": "webp",
        "name": "WebP Image",
        "role": "Viewer"
      }
    ],
    "protocols": [
      {
        "name": "Web",
        "schemes": [
          "http",
          "https"
        ]
      }
    ]
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.1",
    "@ghostery/adblocker-electron": "^2.20.1",
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.16",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sweet-Shots/Pure.git"
  },
  "homepage": "https://github.com/Sweet-Shots/Pure"
}
